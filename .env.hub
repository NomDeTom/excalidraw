# Irate-Box hub build: static, served by Caddy at /draw/, storage via the hub's
# store.py on the same origin (relative URLs, so no CORS and no hostname to bake in).
#   yarn build:hub        (→ excalidraw-app/build)
VITE_APP_STORAGE_BACKEND=http
VITE_APP_HTTP_STORAGE_BACKEND_URL=/api/v2
VITE_APP_BACKEND_V2_GET_URL=/api/v2/scenes/
VITE_APP_BACKEND_V2_POST_URL=/api/v2/scenes/
VITE_APP_WS_SERVER_URL=
VITE_APP_FIREBASE_CONFIG={}
VITE_APP_LIBRARY_URL=
VITE_APP_LIBRARY_BACKEND=
VITE_APP_PLUS_LP=
VITE_APP_PLUS_APP=
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
# Hide Excalidraw+ promos, sign-up, AI, social links, library browsing and analytics.
VITE_APP_OFFLINE=true
VITE_APP_GIT_SHA=hub
# Build lean: run `yarn test:typecheck` separately. Checking in parallel with the bundle
# peaks near 3 GB, which does not fit beside an editor on a 6 GB WSL.
VITE_APP_ENABLE_ESLINT=false
VITE_APP_ENABLE_TYPECHECK=false
